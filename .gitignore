__pycache__/
*.pyc
.DS_Store

# your own files: song audio, finished videos, models, sign-ins, logs
music/
models/
secrets/
logs/
*.wav
*.mp3
*.mp4

# fonts are downloaded separately (see assets/fonts/README.md)
assets/fonts/*
!assets/fonts/README.md

# everything the pipeline writes into a song's build/ except the timing data kept in the repo
songs/*/build/*
!songs/*/build/timed.json
!songs/*/build/beats.json
!songs/*/build/sections.json
!songs/*/build/clips.json
!songs/rate-limited/build/spec.npy

# Allow (Fangs for Asking): its photographic plates, stills and resumable render chunks stay local
songs/allow-fangs-for-asking/plates/
songs/allow-fangs-for-asking/stills/
songs/allow-fangs-for-asking/*.parts/

# the brand covers' lockup photo stays local (see assets/brand/README.md)
assets/brand/*
!assets/brand/README.md

# the 3D films' fonts, baked textures and npm installs stay local (see assets/fonts/README.md)
songs/*/web/fonts/
songs/*/web/tex/
songs/*/web/node_modules/
