{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "lib": [
      "es2015",
      "dom",
      "es2020"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "_wip_src",
    "node_modules",
    "probe/*_wip.ts",
    "probe/landing_scan.ts",
    "probe/landing_search.ts",
    "remotion.config.ts"
  ],
  "include": [
    "src/le/film/**/*",
    "src/glsl/**/*"
  ]
}
